{
  "manifest_version": 3,
  "name": "Amazon Canada Shift Watcher",
  "version": "1.3.0",
  "description": "Alerts you about Amazon Canada hiring shifts and opens the listing for manual confirmation.",
  "permissions": ["alarms", "notifications", "storage", "tabs"],
  "host_permissions": ["https://hiring.amazon.ca/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Amazon Canada Shift Watcher",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://hiring.amazon.ca/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
